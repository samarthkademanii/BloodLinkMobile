# Copy this file to .env and set your backend's URL.
#
# Local development (phone and computer on the same Wi-Fi): use your
# computer's LAN IP, e.g. http://192.168.1.42:4000/api — NOT localhost,
# since "localhost" on the phone means the phone itself.
#
# Production: use your deployed backend's URL, e.g.
# https://bloodlink-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://192.168.1.125:4000/api
